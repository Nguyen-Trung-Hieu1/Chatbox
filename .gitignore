# Go cache and build artifacts
.gocache/
.tmp-go-cache/
.tmp-npm-cache/
*.exe
*.test
coverage.out

# Environment files and secrets
.env
.env.*
!.env.example
backend/.env

# Frontend dependencies and production builds
frontend/node_modules/
frontend/build/

# Logs and editor files
*.log
npm-debug.log*
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local migration backups (contain private application data)
.migration-private/

# Terraform local state, plans and private inputs
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
!**/*.tfvars.example
**/backend.hcl
